# GitHub MCP Server Token (escopos: repo, workflow, read:org)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_TOKEN_HERE_SAMPLE_ONLY_0000000000

# Google Stitch MCP Server Key
STITCH_GOOGLE_API_KEY=AIzaSy_FAKE_TOKEN_FOR_DETECTION_0192_EXAMPLE

# Configuração de Infraestrutura e Portas Padrão
PORT_API_BACKEND=8000
PORT_WEB_FRONTEND=3000
PORT_DASHBOARD_VITE=5173
PORT_OLLAMA=11434
PORT_OMNIROUTE=20128

# Banco de Dados Local (Postgres Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/antigravity_db
REDIS_URL=redis://localhost:6379/0
